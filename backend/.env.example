NODE_ENV=development

HOST=127.0.0.1
PORT=8000

# Priority 1: complete MySQL URL.
DATABASE_URL=

# Priority 2: used only when DATABASE_URL is empty.
DB_HOST=
DB_PORT=3306
DB_NAME=wealthflow
DB_USER=
DB_PASSWORD=

DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Local development identity only; production trusts authenticated proxy headers.
DEV_USER_ID=local-development-user
DEV_USER_EMAIL=local@wealthflow.test
DEV_USER_NAME=本地开发用户
# Guard for disposable integration databases only.
MYSQL_TEST_ALLOW_WRITE=0
