NODE_ENV=development

HOST=127.0.0.1
PORT=8000

# Priority 1: complete MySQL URL.
DATABASE_URL=

# Priority 2: used only when DATABASE_URL is empty.
DB_HOST=
DB_PORT=3306
DB_NAME=wealthflow
DB_USER=
DB_PASSWORD=

DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Required in production. Generate a random value containing at least 32 characters.
AUTH_SECRET=
AUTH_COOKIE_NAME=wealthflow_session
AUTH_SESSION_DAYS=30

# Guard for disposable integration databases only.
MYSQL_TEST_ALLOW_WRITE=0
